# Kopieer naar .env.local en vul in. Nooit committen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server en scripts, nooit in de browser (ook in Vercel als gewone, niet-publieke variabele):
SUPABASE_SERVICE_ROLE_KEY=
# Voor `supabase db push` (databasewachtwoord):
SUPABASE_DB_PASSWORD=
# Geheime sleutel voor /api/blijf-actief (Vercel Cron en GitHub Actions). Zelf verzinnen: een lange willekeurige tekst.
CRON_SECRET=
